#!/usr/bin/env python3

import os
import subprocess
import sys

def main():
    matrepair = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "matrepair"
    )

    command = [
        matrepair,
        *sys.argv[1:],
        "--hybrid"
    ]

    sys.exit(subprocess.call(command))

if __name__ == "__main__":
    main()
